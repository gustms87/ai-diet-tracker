# 이 파일을 참고해 Render 대시보드 > Environment 에 값을 입력하세요.
# (실제 비밀값은 절대 GitHub에 올리지 마세요)

# 앱 로그인 비밀번호 (비워두면 잠금 없음 - 클라우드에서는 반드시 설정)
APP_PASSWORD=

# Turso 클라우드 DB (https://app.turso.tech 에서 발급)
TURSO_DATABASE_URL=libsql://diet-xxxx.aws-ap-northeast-1.turso.io
TURSO_AUTH_TOKEN=

# Google Gemini API 키 (https://aistudio.google.com/app/apikey) - 앱 설정 화면에서 입력해도 됨
GEMINI_API_KEY=
